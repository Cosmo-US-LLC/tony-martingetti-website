# Same Supabase project as tonymartignetti-blog-cms - anon key only.
# Blog pages (/blog, /blog/:slug) read published posts directly from
# Supabase using these; RLS only lets this key see published content.
# Never put the service-role key here - it belongs only in the CMS repo's
# server-side .env.local, never in a Vite app where it would ship to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
